TARGET      :=  build_pc/main
BUILD       :=  build_pc
SOURCES     :=  ../src ../include
INCLUDES    :=  ../include

CFLAGS      := -g -Wall -Oz -ffunction-sections -fdata-sections $(INCLUDES:%=-I%)
CXXFLAGS    := $(CFLAGS) -fno-exceptions -DPC_BUILD

LIBS        :=  -lSDL -lGL -lGLU

CPPFILES := ../main.cpp

OBJS        :=  $(CPPFILES:../src/%.cpp=$(BUILD)/%.o)

$(TARGET): $(OBJS)
	mkdir -p $(BUILD)
	$(CXX) $(OBJS) $(LIBS) -o $(TARGET)


$(BUILD)/%.o: ../src/%.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

clean:
	rm -rf $(BUILD)
