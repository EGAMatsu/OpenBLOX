			<Item class="Script" referent="RBX754">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">AutoWater</string>
					<string name="Source">factory = script.Parent
backup = factory.Stuff.Water
check = script.Parent.WaterAutoCheck
waterTime = factory.WaterAutoTime
count = script.Parent.Counters.Water

while true do
	if check.Value == 1 then
		if count.Value &lt; 10 then
		water = backup.Value:clone()
		water.Parent = factory.Waters
		if factory.Sugar.Value == 1 then
			water.Reflectance = 0.4
			water.Transparency = 0.5
		end
		count.Value = count.Value + 1
		end
		wait(waterTime.Value)
	else
		wait(1)
	end
end
</string>
