					<Item class="Script" referent="RBX1525">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">PaysCash</string>
							<string name="Source">factory = script.Parent.Parent.Parent
dough = factory.doughMoney
bread = factory.breadMoney
chocolate = factory.chocolateMoney
superdough = factory.superdoughMoney
superbread = factory.superbreadMoney
superchocolate = factory.superchocolateMoney
nut = factory.nutMoney
supernut = factory.supernutMoney
local ting = 0

function onTouched(hit)
	if ting == 0 then
		ting = 1
		local user = game.Players:findFirstChild(factory.Owner.Value)
		if user ~= nil and hit.Name == &quot;Bread&quot; then
			local stats = user:findFirstChild(&quot;leaderstats&quot;)
			if stats ~= nil then
				local cash = stats:findFirstChild(&quot;Money&quot;)
				cash.Value = cash.Value + bread.Value
				if hit.choco.Value == 1 then
					cash.Value = cash.Value + chocolate.Value
				end
				if hit.nut.Value == 1 then
					cash.Value = cash.Value + nut.Value
				end
				hit:remove()
			end
		end
		if user ~= nil and hit.Name == &quot;Dough&quot; then
			local stats = user:findFirstChild(&quot;leaderstats&quot;)
			if stats ~= nil then
				local cash = stats:findFirstChild(&quot;Money&quot;)
				cash.Value = cash.Value + dough.Value
				if hit.choco.Value == 1 then
					cash.Value = cash.Value + chocolate.Value
				end
				if hit.nut.Value == 1 then
					cash.Value = cash.Value + nut.Value
				end
				hit:remove()
			end
		end
		if user ~= nil and hit.Name == &quot;SuperDough&quot; then
			local stats = user:findFirstChild(&quot;leaderstats&quot;)
			if stats ~= nil then
				local cash = stats:findFirstChild(&quot;Money&quot;)
				cash.Value = cash.Value + superdough.Value
				if hit.choco.Value == 1 then
					cash.Value = cash.Value + superchocolate.Value
				end
				if hit.nut.Value == 1 then
					cash.Value = cash.Value + supernut.Value
				end
				hit:remove()
			end
		end
		if user ~= nil and hit.Name == &quot;SuperBread&quot; then
			local stats = user:findFirstChild(&quot;leaderstats&quot;)
			if stats ~= nil then
				local cash = stats:findFirstChild(&quot;Money&quot;)
				cash.Value = cash.Value + superbread.Value
				if hit.choco.Value == 1 then
					cash.Value = cash.Value + superchocolate.Value
				end
				if hit.nut.Value == 1 then
					cash.Value = cash.Value + supernut.Value
				end
				hit:remove()
			end
		end
		if user ~= nil then
		if hit ~= nil and hit.Name == &quot;top&quot; then
			hit.Velocity=Vector3.new(0,30,30)
		end
		end
		ting = 0
	end
end

script.Parent.Touched:connect(onTouched)
</string>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
