				<Item class="IntValue" referent="RBX2024">
					<Properties>
						<string name="Name">ChimneyCheck</string>
						<int name="Value">1</int>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX2025">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Cost</string>
						<string name="Source">factory = script.Parent.Parent
on = script.Parent.on

while true do
	if on.Value == 1 and factory.Oven.ChimneyCheck.Value == 0 then
		local user = game.Players:findFirstChild(factory.Owner.Value)
		if user ~= nil then
			local stats = user:findFirstChild(&quot;leaderstats&quot;)
			if stats ~= nil then
				local cash = stats:findFirstChild(&quot;Money&quot;)
				if cash.Value &gt; 4 then
				cash.Value = cash.Value -5
				wait(15)
				else
				on.Value = 0
				factory.Oven.glower.BrickColor = BrickColor.new(26)
				end
			end
		end
	else
		wait(1)
	end	
end
</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
