					<Item class="Script" referent="RBX2046">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">1FlourBuy</string>
							<string name="Source">factory = script.Parent.Parent.Parent
local ting = 0
count = factory.Counters.SuperFlour

function onTouch(hit)
if factory.FlourAutoCheck.Value == 1 then
	script.Parent.Parent.Name = &quot;Shutdown auto-production first&quot;
	wait(3)
	script.Parent.Parent.Name = &quot;Buy 1 super-Flour. 5000,-&quot;
end

if ting == 0 and factory.FlourAutoCheck.Value == 0 then
	ting = 1
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
	if check ~= nil then
		local user = game.Players:GetPlayerFromCharacter(hit.Parent)
		local owner = factory.Owner.Value
		if owner == user.Name then
			local stats = user:findFirstChild(&quot;leaderstats&quot;)
			if stats ~= nil then
				local cash = stats:findFirstChild(&quot;Money&quot;)
				if cash.Value &gt; 4999 then
					if count.Value &lt; 1 then
					cash.Value = cash.Value -5000
					newflour = factory.Stuff.SuperFlour.Value:clone()
					newflour.Parent = factory.Flours
					count.Value = count.Value + 1
					end
					wait(2)
				end
			end
		end
	end
	ting = 0
end
end

script.Parent.Touched:connect(onTouch)
