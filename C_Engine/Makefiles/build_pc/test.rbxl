			<Item class="Script" referent="RBX1719">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">BreakStuffScript</string>
					<string name="Source">message = Instance.new(&quot;Message&quot;) 
factory = script.Parent
breakstuff = factory.Breakstuff
jump = 5

while true do
if breakstuff.Value == 1 then
	check = math.random(1,100)
	print(check)

	if check == 10 then --Break oven
	thing = factory:findFirstChild(&quot;Oven&quot;)
	if thing ~= nil then 
		print(&quot;Oven broken&quot;)
		c = thing.Break:getChildren()
		for i=1, #c do
			c[i].Anchored = false
		end
		thing.Break:BreakJoints()
		button = factory.BrokenStuff.RepairOven.Value:clone()
		button.Parent = factory
		message.Text = &quot;Your Oven is broken&quot;
		breakstuff.Value = 0
		message.Parent = game.Players:findFirstChild(factory.Owner.Value)
		wait(2)
		message.Parent = nil
	end
	end

	if check == 20 then --Break oven&apos;s chimney
	thing = factory:findFirstChild(&quot;Oven&quot;)
	if thing ~= nil then 
	thing = thing:findFirstChild(&quot;Chimney&quot;)
	if thing ~= nil then 
		print(&quot;Chimney broken&quot;)
		c = thing.Break:getChildren()
		for i=1, #c do
			c[i].Anchored = false
		end
		thing.Break:BreakJoints()
		button = factory.BrokenStuff.RepairChimney.Value:clone()
		button.Parent = factory
		breakstuff.Value = 0
	end
	end
	end

	if check == 30 then --Break chocolatemachine
	thing = factory:findFirstChild(&quot;ChocolateMachine&quot;)
	if thing ~= nil then 
		print(&quot;Chocomachine broken&quot;)
		c = thing.Break:getChildren()
		for i=1, #c do
			c[i].Anchored = false
		end
		thing.Break:BreakJoints()
		button = factory.BrokenStuff.RepairChocomachine.Value:clone()
		button.Parent = factory
		breakstuff.Value = 0
	end
	end

	if check == 40 then --Break stairs(1)
	thing = factory:findFirstChild(&quot;Stairs1&quot;)
	if thing ~= nil then 
		print(&quot;Stairs1 broken&quot;)
		c = thing.Break:getChildren()
		for i=1, #c do
			c[i].Anchored = false
		end
		thing.Break:BreakJoints()
		button = factory.BrokenStuff.RepairStairs1.Value:clone()
		button.Parent = factory
		breakstuff.Value = 0
	end
	end

	if check == 50 then --Break stairs(2)
	thing = factory:findFirstChild(&quot;Stairs2&quot;)
	if thing ~= nil then 
		print(&quot;Stairs2 broken&quot;)
		c = thing.Break:getChildren()
		for i=1, #c do
			c[i].Anchored = false
		end
		thing.Break:BreakJoints()
		button = factory.BrokenStuff.RepairStairs2.Value:clone()
		button.Parent = factory
		breakstuff.Value = 0
	end
	end	

	if check == 60 then --Break stairs(3)
	thing = factory:findFirstChild(&quot;Stairs3&quot;)
	if thing ~= nil then 
		print(&quot;Stairs3 broken&quot;)
		c = thing.Break:getChildren()
		for i=1, #c do
			c[i].Anchored = false
		end
		thing.Break:BreakJoints()
		button = factory.BrokenStuff.RepairStairs3.Value:clone()
		button.Parent = factory
		breakstuff.Value = 0
	end
	end

end
wait(1)
end
