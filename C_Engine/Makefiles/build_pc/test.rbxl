factory = script.Parent.Parent.Parent
parent = factory.Oven
fix = factory.BrokenStuff.Oven
local ting = 0

function onTouched(hit)
	if ting == 0 then
	ting = 1
	print(&quot;touched&quot;)
	local owner1 = rep.Owner1.Value
	local owner2 = rep.Owner2.Value
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
	if check ~= nil then
		local user = game.Players:GetPlayerFromCharacter(hit.Parent) 
		if owner1 == user.Name then
			print(&quot;owner ok&quot;)
			local stats = user:findFirstChild(&quot;leaderstats&quot;)
			if stats ~= nil then
				local cash = stats:findFirstChild(&quot;Money&quot;)
				cash.Value  = cash.Value + (100 * rep.Money1.Value)
				factory.Breakstuff.Value = 1
				parent.Break:remove()
				fixedStuff = fix.Value:clone()
				fixedStuff.Parent = parent
				script.Parent.Parent:remove()
			end
		end
		if owner2 == user.Name then
			print(&quot;owner ok&quot;)
			local stats = user:findFirstChild(&quot;leaderstats&quot;)
			if stats ~= nil then
				local cash = stats:findFirstChild(&quot;Money&quot;)
				cash.Value  = cash.Value + (100 * rep.Money2.Value)
				factory.Breakstuff.Value = 1
				parent.Break:remove()
