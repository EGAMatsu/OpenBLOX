				<Item class="Script" referent="RBX1448">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">ChocoTouched</string>
						<string name="Source">local ting = 0
factory = script.Parent.Parent
on = factory.chocolateOn

function onTouch(hit)
	if ting == 0 then
		ting = 1
		if hit.Name == &quot;Dough&quot; then 
		if hit.choco.Value == 0 and on.Value == 1 then
			local user = game.Players:findFirstChild(factory.Owner.Value)
			if user ~= nil then
			local stats = user:findFirstChild(&quot;leaderstats&quot;)
			if stats ~= nil then
				local cash = stats:findFirstChild(&quot;Money&quot;)
				if cash.Value &gt; 9 then
					hit.top.Transparency = 0
					hit.top.BrickColor = BrickColor.new(192)
					hit.choco.Value = 1
					cash.Value = cash.Value - 10
				else
					on.Value = 0
				end
			end
			end
		end
		end 
		if hit.Name == &quot;SuperDough&quot; then 
		if hit.choco.Value == 0 and on.Value == 1 then
			local user = game.Players:findFirstChild(factory.Owner.Value)
			if user ~= nil then
			local stats = user:findFirstChild(&quot;leaderstats&quot;)
			if stats ~= nil then
				local cash = stats:findFirstChild(&quot;Money&quot;)
				if cash.Value &gt; 99 then
					hit.top.Transparency = 0
					hit.top.BrickColor = BrickColor.new(192)
					hit.choco.Value = 1
					cash.Value = cash.Value - 100
				else
					on.Value = 0
				end
			end
			end
		end
		end 
		ting = 0
	end
end

script.Parent.Touched:connect(onTouch)
