							<string name="Source">factory = script.Parent.Parent.Parent
local ting = 0

function onTouched(hit)
	if ting == 0 then
	ting = 1
	print(&quot;touched&quot;)
	local owner = factory.Owner.Value
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
	if check ~= nil then
		local user = game.Players:GetPlayerFromCharacter(hit.Parent) 
		if owner == user.Name then
			print(&quot;owner ok&quot;)
			local stats = user:findFirstChild(&quot;leaderstats&quot;)
			if stats ~= nil then
				local cash = stats:findFirstChild(&quot;Money&quot;)
				if cash.Value &gt; 7499 then
					cash.Value  = cash.Value -7500
					factory.breadMoney.Value = factory.breadMoney.Value * 2
					factory.doughMoney.Value = factory.doughMoney.Value * 2
					factory.chocolateMoney.Value = factory.chocolateMoney.Value * 2
					factory.superbreadMoney.Value = factory.superbreadMoney.Value * 2
					factory.superdoughMoney.Value = factory.superdoughMoney.Value * 2
					factory.superchocolateMoney.Value = factory.superchocolateMoney.Value * 2
					factory.Sugar.Value = 1
					script.Parent.Parent:remove()
				end
			end
		end
	end
	ting = 0
	end
end

script.Parent.Touched:connect(onTouched)
