		<Item class="Model" referent="RBX724">
			<Properties>
				<token name="Controller">0</token>
				<bool name="ControllerFlagShown">true</bool>
				<CoordinateFrame name="ModelInPrimary">
					<X>0</X>
					<Y>0</Y>
					<Z>0</Z>
					<R00>1</R00>
					<R01>0</R01>
					<R02>0</R02>
					<R10>0</R10>
					<R11>1</R11>
					<R12>0</R12>
					<R20>0</R20>
					<R21>0</R21>
					<R22>1</R22>
				</CoordinateFrame>
				<string name="Name">Factory</string>
				<Ref name="PrimaryPart">RBX725</Ref>
				<bool name="archivable">true</bool>
			</Properties>
			<Item class="IntValue" referent="RBX726">
				<Properties>
					<string name="Name">FlourAutoCheck</string>
					<int name="Value">0</int>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX727">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">AutoFlour</string>
					<string name="Source">factory = script.Parent
backup = factory.Stuff.Flour
check = script.Parent.FlourAutoCheck
flourTime = factory.FlourAutoTime
count = factory.Counters.Flour

while true do
	if check.Value == 1 then
		local user = game.Players:findFirstChild(factory.Owner.Value)
		if user ~= nil then
			local stats = user:findFirstChild(&quot;leaderstats&quot;)
			if stats ~= nil then
				local cash = stats:findFirstChild(&quot;Money&quot;)
				if cash.Value &gt; 4 then
					if count.Value &lt; 5 then
					cash.Value = cash.Value -5
					flour = backup.Value:clone()
					flour.Parent = factory.Flours
					count.Value = count.Value + 1
					end
					wait(flourTime.Value)
				else
					check.Value = 0
				end
			end
		end
	else
		wait(1)
	end
end
</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="StringValue" referent="RBX728">
