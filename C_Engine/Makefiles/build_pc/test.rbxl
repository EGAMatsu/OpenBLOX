								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<string name="Source">factory = script.Parent.Parent.Parent.Parent
local ting = 0

function onTouched(hit)
	if ting == 0 then
	ting = 1
	print(&quot;touched&quot;)
	local owner = factory.Owner.Value
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
	if check ~= nil then
		local user = game.Players:GetPlayerFromCharacter(hit.Parent) 
		if owner == user.Name then
			print(&quot;owner ok&quot;)
			local stats = user:findFirstChild(&quot;leaderstats&quot;)
			if stats ~= nil then
				local cash = stats:findFirstChild(&quot;Money&quot;)
				if cash.Value &gt; 999 then
					cash.Value  = cash.Value -1000
					factory.FlourAutoTime.Value = factory.FlourAutoTime.Value / 2.0
					factory.WaterAutoTime.Value = factory.WaterAutoTime.Value / 2.0
					script.Parent.Parent:remove()
				end
			end
		end
	end
	ting = 0
	end
end

script.Parent.Touched:connect(onTouched)
