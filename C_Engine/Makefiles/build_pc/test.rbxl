					<Item class="Script" referent="RBX1511">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<string name="Source">factory = script.Parent.Parent.Parent
backup = factory.Stuff.Blocker
local ting = 0
message = Instance.new(&quot;Message&quot;)

function onTouched(hit)
	if ting == 0 then
	ting = 1
	local owner = factory.Owner.Value
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
	if check ~= nil then
		local user = game.Players:GetPlayerFromCharacter(hit.Parent) 
		if owner ~= user.Name then
			print(&quot;Ownercheck ok&quot;)
			local stats = user:findFirstChild(&quot;leaderstats&quot;)
			if stats ~= nil then
				local cash = stats:findFirstChild(&quot;Money&quot;)
				if cash.Value &gt; 4999 then
					print(&quot;checking for owner&quot;)
					messageText = &quot;You have been sabotaged by &quot; .. user.Name .. &quot;!&quot;
					message.Text = messageText
					ownert = game.Players:findFirstChild(owner)
					if ownert ~= nil then 
					print(&quot;Owner found&quot;)
					blocker = backup.Value:clone()
					message.Parent = ownert
					blocker.Parent = factory.Sabotage
					cash.Value  = cash.Value -5000
					script.Parent.Parent.Name = &quot;--Resetting--&quot;
					wait(3)
					message.Parent = nil
					wait(57)
					blocker:remove()
					wait(140)
					script.Parent.Parent.Name = &quot;Sabotage -- Bread Blocker 5000,-&quot;
					end
				end
			end
		end
	end
	ting = 0
	end
end

script.Parent.Touched:connect(onTouched)
</string>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
				</Item>
			</Item>
