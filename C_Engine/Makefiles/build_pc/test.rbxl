					<Item class="Script" referent="RBX603">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">OvenTouched</string>
							<string name="Source">local ting = 0
on = script.Parent.Parent.on

function onTouch(hit)
	if ting == 0 and on.Value == 1 then
		ting = 1
		if hit.Name == &quot;Dough&quot; then
			hit.BrickColor = BrickColor.new(106)
			hit.Name = &quot;Bread&quot;
		end
		if hit.Name == &quot;SuperDough&quot; then
			hit.BrickColor = BrickColor.new(24)
			hit.Name = &quot;SuperBread&quot;
		end
		ting = 0
	end
end

script.Parent.Touched:connect(onTouch)
</string>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
				</Item>
